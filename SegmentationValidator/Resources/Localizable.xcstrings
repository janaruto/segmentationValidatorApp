    },
    "The file is empty." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei ist leer."
          }
        }
      }
    },
    "The file is not a text file." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei ist keine Textdatei."
          }
        }
      }
    },
    "The file needs the columns movement_type and start_iso (or date and start_time)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei braucht die Spalten movement_type und start_iso (oder date und start_time)."
          }
        }
      }
    },
    "The motion sensor notices when you start moving and the app reminds you to log the segment, with day and times already filled in and the previous segment shown for checking." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Bewegungssensor merkt, wenn du dich in Bewegung setzt, und die App erinnert dich daran, das Segment zu erfassen – Tag und Zeiten sind schon ausgefüllt und das vorherige Segment wird zur Kontrolle angezeigt."
          }
        }
      }
    },
    "The phone has not moved since %@. The end is filled in, adjust it if needed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das iPhone hat sich seit %@ nicht mehr bewegt. Das Ende ist ausgefüllt, passe es bei Bedarf an."
          }
        }
      }
    },
    "The phone noticed a vehicle. Which one was it?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das iPhone hat ein Fahrzeug erkannt. Welches war es?"
          }
        }
      }
    },
    "The question arrives in 5 seconds. Touch and hold it to answer True or False." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Frage kommt in 5 Sekunden. Halte sie gedrückt, um mit True oder False zu antworten."
          }
        }
      }
    },
    "The reminder arrives in 5 seconds. Lock your iPhone to see it like a real one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Erinnerung kommt in 5 Sekunden. Sperre dein iPhone, um sie wie eine echte zu sehen."
          }
        }
      }
    },
    "The running segment (%1$@) will end at %2$@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das laufende Segment (%1$@) endet um %2$@."
