            "value" : "Test"
          }
        }
      }
    },
    "The data file was damaged. A copy was kept as %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datendatei war beschädigt. Eine Kopie wurde als %@ aufbewahrt."
          }
        }
      }
    },
    "The end must be after the start." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ende muss nach dem Start liegen."
          }
        }
