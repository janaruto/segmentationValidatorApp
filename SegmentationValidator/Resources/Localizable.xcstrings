    "A reminder was sent recently. The next one follows later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor Kurzem wurde schon erinnert. Die nächste Erinnerung folgt später."
