        }
      }
    },
    "A reminder was sent recently. The next one follows later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor Kurzem wurde schon erinnert. Die nächste Erinnerung folgt später."
          }
        }
      }
    },
    "A running segment cannot start in the future." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein laufendes Segment kann nicht in der Zukunft beginnen."
          }
        }
      }
    },
    "A running segment ends when you tap Stop or start another one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein laufendes Segment endet, wenn du auf «Stopp» tippst oder ein anderes startest."
          }
        }
      }
    },
