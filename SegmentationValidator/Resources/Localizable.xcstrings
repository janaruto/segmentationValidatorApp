{
  "sourceLanguage" : "en",
  "strings" : {
    "%1$@ away from where you were at %2$@. Are you on the move?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ entfernt von dort, wo du um %2$@ warst. Bist du unterwegs?"
          }
        }
      }
    },
    "%1$@ is still running, but you seem to have stopped at %2$@. Tap to end it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ läuft noch, aber du scheinst um %2$@ angehalten zu haben. Tippe, um es zu beenden."
          }
        }
      }
    },
    "%1$@ – %2$@, probably %3$@. Tap to log the segment." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ – %2$@, vermutlich %3$@. Tippe, um das Segment zu erfassen."
          }
        }
      }
    },
    "%1$lld added, %2$lld updated, %3$lld already known." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld hinzugefügt, %2$lld aktualisiert, %3$lld schon vorhanden."
          }
        }
      }
    },
    "%1$lld points · %2$@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld Punkte · %2$@"
          }
        }
      }
    },
    "%@ (ongoing)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (läuft)"
          }
        }
      }
    },
    "%@ from the previous point" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vom vorherigen Punkt"
          }
        }
      }
    },
    "%@ logged" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ erfasst"
          }
        }
      }
    },
    "%@ not logged · tap to fill" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nicht erfasst · zum Ausfüllen tippen"
