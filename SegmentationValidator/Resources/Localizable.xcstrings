    "Walking" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu Fuss"
          }
        }
      }
    },
    "What are you doing right now?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was machst du gerade?"
          }
        }
      }
    },
    "You can still log segments and see detected movements in the app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst weiterhin Segmente erfassen und erkannte Bewegungen in der App sehen."
          }
        }
      }
    },
    "Your data" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Daten"
          }
        }
      }
    },
    "Your data is not accessible right now. Unlock your iPhone and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Daten sind gerade nicht zugänglich. Entsperre dein iPhone und versuche es erneut."
          }
        }
      }
    },
    "Your data stays on this iPhone. No account, no server, no costs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Daten bleiben auf diesem iPhone. Kein Konto, kein Server, keine Kosten."
          }
        }
      }
    },
    "Your segments are kept. Export the location points first if you want to keep a copy." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Segmente bleiben erhalten. Exportiere die Standortpunkte vorher, wenn du eine Kopie behalten möchtest."
          }
        }
      }
    },
    "by bike" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mit dem Velo"
          }
        }
      }
    },
    "has segments" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "hat Segmente"
          }
        }
      }
    },
    "iOS keeps motion data for 7 days, so there are no suggestions for this day." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS speichert Bewegungsdaten 7 Tage lang, daher gibt es für diesen Tag keine Vorschläge."
          }
        }
      }
    },
    "iOS lets a closed app check the motion sensor only now and then, so reminders can be late. With this option iOS wakes the app whenever you move a few hundred meters (requires location access \"Always\"). Your location is never stored or sent anywhere." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS lässt eine geschlossene App nur ab und zu den Bewegungssensor prüfen, daher können Erinnerungen verspätet kommen. Mit dieser Option weckt iOS die App, sobald du dich ein paar hundert Meter bewegst (benötigt Standortzugriff «Immer»). Dein Standort wird nie gespeichert oder irgendwohin gesendet."
          }
        }
      }
    },
    "in a vehicle" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "in einem Fahrzeug"
          }
        }
      }
    },
    "live" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "läuft"
          }
        }
      }
    },
    "now" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "jetzt"
          }
        }
      }
    },
