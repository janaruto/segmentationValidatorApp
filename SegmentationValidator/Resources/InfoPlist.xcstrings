    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional: Die App speichert alle paar Minuten einen Standortpunkt und fragt, ob du unterwegs oder angekommen bist. iOS kann die App ausserdem wecken, wenn du dich bewegst. Die Standortpunkte bleiben auf deinem iPhone und werden nirgendwohin gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional: the app saves a location point every few minutes and asks whether you are on the move or have arrived. iOS can also wake the app when you move. Location points stay on your iPhone and are never sent anywhere."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional: Die App speichert alle paar Minuten einen Standortpunkt und fragt, ob du unterwegs oder angekommen bist. iOS kann die App ausserdem wecken, wenn du dich bewegst. Die Standortpunkte bleiben auf deinem iPhone und werden nirgendwohin gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional: the app saves a location point every few minutes and asks whether you are on the move or have arrived. iOS can also wake the app when you move. Location points stay on your iPhone and are never sent anywhere."
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Bewegungssensor erkennt, wenn du dich in Bewegung setzt. So kann die App dich ans Erfassen des Segments erinnern und Start- und Endzeit vorschlagen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The motion sensor detects when you start moving, so the app can remind you to log the segment and suggest its start and end time."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
